@inherits LayoutComponentBase
@inject IOptions<StoreOptions> Store

<div class="account-page">
    <RadzenCard class="account-card">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
            <RadzenIcon Icon="point_of_sale" />
            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@Store.Value.Name</RadzenText>
        </RadzenStack>
        @Body
    </RadzenCard>
</div>
